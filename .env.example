# google oauth (single consent flow: gmail readonly, calendar readonly, docs readonly)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# local paths
MERIDIAN_DATA_DIR=./data
MERIDIAN_LOG_DIR=./logs
# notes/transcripts folder scanned by `python -m meridian.ingestion.local_files`.
# recurses into subfolders; only .txt and .md files are ingested (hardcoded,
# not configurable yet); dotfiles/dot-directories (.git, .obsidian, etc.) are
# always skipped.
MERIDIAN_NOTES_FOLDER=

# external api used for grounded generation (redacted text only, per core principles)
# leave LLM_API_KEY empty to run phase 8 (query) with retrieval only - it
# still finds and ranks relevant content without generating an answer.
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5

# gmail ingestion - optional search query to scope the initial backfill
# (e.g. "newer_than:365d"). leave empty to sync the entire mailbox on
# first run.
GMAIL_SYNC_QUERY=

# calendar ingestion - optional rfc3339 lower bound (e.g. 2024-01-01T00:00:00Z)
# for the initial full backfill only. leave empty to sync the calendar's
# entire history on first run. note: once a sync token exists, incremental
# syncs are calendar-wide and are not re-bounded by this value (google's api
# forbids combining synctoken with timemin) -- it only limits what's pulled
# in on the first run or a forced --full-resync.
CALENDAR_SYNC_TIME_MIN=

# docs ingestion - optional extra drive query clause anded onto the fixed
# "mimetype='application/vnd.google-apps.document' and trashed=false" filter,
# used only for the initial full backfill (e.g. "'<folder_id>' in parents" to
# scope to one drive folder). leave empty to sync every google doc you can
# see on first run. note: once a page token exists, incremental syncs via
# drive's changes.list cover the whole drive and cannot be re-scoped by this
# value (changes.list takes no query parameter at all) -- it only limits
# what's pulled in on the first run or a forced --full-resync.
DOCS_SYNC_DRIVE_QUERY=
